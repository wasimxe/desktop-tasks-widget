using System;
using System.IO;
using System.Runtime.InteropServices;
using System.Windows;
using System.Windows.Input;
using System.Windows.Interop;
using System.Windows.Media.Imaging;
using System.Windows.Media;

namespace DesktopTasks.Windows
{
    public partial class DesktopOverlay : Window
    {
        private readonly string _htmlFilePath;
        private readonly string _settingsPath;
        private readonly string _tempHtmlPath;
        private bool _isLocked = true;
        private bool _contentChanged = false;

        private const int GWL_EXSTYLE = -20;
        private const int WS_EX_TRANSPARENT = 0x00000020;
        private const int WS_EX_NOACTIVATE = 0x08000000;
        private const int WS_EX_TOOLWINDOW = 0x00000080;
        private const int WS_EX_LAYERED = 0x00080000;

        [DllImport("user32.dll")]
        private static extern int GetWindowLong(IntPtr hwnd, int index);

        [DllImport("user32.dll")]
        private static extern int SetWindowLong(IntPtr hwnd, int index, int newStyle);

        [DllImport("user32.dll")]
        private static extern bool EnumChildWindows(IntPtr hwnd, EnumChildProc enumProc, IntPtr lParam);

        private delegate bool EnumChildProc(IntPtr hwnd, IntPtr lParam);

        public DesktopOverlay()
        {
            InitializeComponent();

            var appDataPath = Path.Combine(
                Environment.GetFolderPath(Environment.SpecialFolder.ApplicationData),
                "DesktopTasks"
            );
            Directory.CreateDirectory(appDataPath);

            _htmlFilePath = Path.Combine(appDataPath, "widget.html");
            _settingsPath = Path.Combine(appDataPath, "widget-settings.txt");
            _tempHtmlPath = Path.Combine(appDataPath, "widget-temp.html");

            Loaded += DesktopOverlay_Loaded;
            Closing += DesktopOverlay_Closing;

            // Suppress script errors and context menu
            HtmlBrowser.LoadCompleted += (s, e) =>
            {
                try
                {
                    dynamic? activeX = HtmlBrowser.Document;
                    if (activeX != null)
                    {
                        activeX.parentWindow.execScript("window.onerror = function() { return true; }", "javascript");

                        // Disable context menu when locked
                        if (_isLocked)
                        {
                            activeX.parentWindow.execScript(@"
                                document.oncontextmenu = function() { return false; };
                                document.body.oncontextmenu = function() { return false; };
                            ", "javascript");

                            // Make all WebBrowser child windows transparent
                            MakeWebBrowserTransparent();
                        }
                    }
                }
                catch { }
            };

            // Create default content if needed
            if (!File.Exists(_htmlFilePath))
            {
                CreateDefaultContent();
            }

            LoadSettings();
        }

        private void DesktopOverlay_Loaded(object sender, RoutedEventArgs e)
        {
            // Ensure window handle is created
            var hwnd = new WindowInteropHelper(this).EnsureHandle();

            SetLockState(_isLocked);
            if (_isLocked)
            {
                RefreshHtmlView();
            }
        }

        private void DesktopOverlay_Closing(object? sender, System.ComponentModel.CancelEventArgs e)
        {
            if (_contentChanged && !_isLocked)
            {
                var result = MessageBox.Show("You have unsaved changes. Save before closing?",
                    "Unsaved Changes", MessageBoxButton.YesNoCancel, MessageBoxImage.Question);

                if (result == MessageBoxResult.Yes)
                {
                    SaveContent();
                }
                else if (result == MessageBoxResult.Cancel)
                {
                    e.Cancel = true;
                    return;
                }
            }

            SaveSettings();
        }

        public void ToggleLock()
        {
            _isLocked = !_isLocked;
            SetLockState(_isLocked);
        }

        public bool IsLocked => _isLocked;

        private void SetLockState(bool locked)
        {
            _isLocked = locked;

            var hwnd = new WindowInteropHelper(this).Handle;
            if (hwnd == IntPtr.Zero) return;

            int extendedStyle = GetWindowLong(hwnd, GWL_EXSTYLE);

            if (locked)
            {
                // Save any changes before locking
                if (_contentChanged)
                {
                    SaveContent();
                }

                // LOCKED: Show HTML view with transparent overlay for click-through
                HtmlScrollViewer.Visibility = Visibility.Visible;
                HtmlBrowser.Visibility = Visibility.Visible;
                TransparentOverlay.Visibility = Visibility.Visible; // Show overlay on top
                TransparentOverlay.IsHitTestVisible = false; // Make overlay truly transparent
                HtmlBrowser.IsHitTestVisible = false; // Disable WebBrowser interaction
                HtmlScrollViewer.IsHitTestVisible = false; // Disable ScrollViewer interaction
                MainBorder.IsHitTestVisible = false; // Disable border interaction
                EditorPanel.Visibility = Visibility.Collapsed;

                // First show the content
                RefreshHtmlView();

                // Apply click-through window style
                SetWindowLong(hwnd, GWL_EXSTYLE,
                    extendedStyle | WS_EX_TRANSPARENT | WS_EX_LAYERED | WS_EX_TOOLWINDOW);

                ResizeMode = ResizeMode.NoResize;
                Cursor = Cursors.Arrow;
                Focusable = false;
            }
            else
            {
                // UNLOCKED: Show editor, interactive
                LoadEditorContent();

                HtmlScrollViewer.Visibility = Visibility.Collapsed;
                HtmlBrowser.Visibility = Visibility.Collapsed;
                TransparentOverlay.Visibility = Visibility.Collapsed;
                HtmlBrowser.IsHitTestVisible = true;
                HtmlScrollViewer.IsHitTestVisible = true;
                MainBorder.IsHitTestVisible = true;
                EditorPanel.Visibility = Visibility.Visible;

                SetWindowLong(hwnd, GWL_EXSTYLE,
                    (extendedStyle | WS_EX_TOOLWINDOW) & ~WS_EX_TRANSPARENT & ~WS_EX_NOACTIVATE & ~WS_EX_LAYERED);
                ResizeMode = ResizeMode.CanResize;
                Cursor = Cursors.Arrow;
                Focusable = true;
            }

            SaveSettings();
        }

        protected override void OnMouseLeftButtonDown(MouseButtonEventArgs e)
        {
            base.OnMouseLeftButtonDown(e);
            if (!_isLocked)
            {
                try
                {
                    DragMove();
                    SaveSettings();
                }
                catch { }
            }
        }

        private void LoadEditorContent()
        {
            try
            {
                if (File.Exists(_htmlFilePath))
                {
                    HtmlTextBox.Text = File.ReadAllText(_htmlFilePath);
                }

                _contentChanged = false;
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Error loading content: {ex.Message}", "Error",
                    MessageBoxButton.OK, MessageBoxImage.Error);
            }
        }

        private void SaveContent()
        {
            try
            {
                File.WriteAllText(_htmlFilePath, HtmlTextBox.Text);
                _contentChanged = false;
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Error saving content: {ex.Message}", "Error",
                    MessageBoxButton.OK, MessageBoxImage.Error);
            }
        }

        private void RefreshHtmlView()
        {
            try
            {
                string html = File.ReadAllText(_htmlFilePath);

                string fullHtml = $@"<!DOCTYPE html>
<html>
<head>
    <meta http-equiv='X-UA-Compatible' content='IE=edge'/>
    <style>
        ::-webkit-scrollbar {{ display: none; }}
        html {{ -ms-overflow-style: none; scrollbar-width: none; }}
        body {{ margin: 0; padding: 0; overflow-y: auto; overflow-x: hidden; }}
    </style>
</head>
<body>
    {html}
</body>
</html>";

                File.WriteAllText(_tempHtmlPath, fullHtml);
                HtmlBrowser.Navigate(new Uri(_tempHtmlPath));
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Error loading HTML: {ex.Message}", "Error",
                    MessageBoxButton.OK, MessageBoxImage.Error);
            }
        }

        private void Editor_TextChanged(object sender, System.Windows.Controls.TextChangedEventArgs e)
        {
            _contentChanged = true;
        }

        private void SaveChanges_Click(object sender, RoutedEventArgs e)
        {
            SaveContent();

            // Automatically lock and show HTML view
            _isLocked = false; // Set to false so ToggleLock will set it to true
            SetLockState(true);
        }

        private void CreateDefaultContent()
        {
            string defaultHtml = @"<style>
    body {
        background: transparent;
        padding: 0;
