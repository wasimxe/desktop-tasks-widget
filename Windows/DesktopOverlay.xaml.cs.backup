        color: #666;
        flex-shrink: 0;
    }
    .task-content {
        flex: 1;
    }
    .task-title {
        color: #2c3e50;
        font-size: 14px;
        font-weight: 500;
        margin-bottom: 4px;
    }
    .task-meta {
        color: #7f8c8d;
        font-size: 11px;
    }
    .info-box {
        background: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(10px);
        padding: 12px;
        border-radius: 8px;
        color: white;
        font-size: 12px;
        margin-top: 20px;
        border: 1px solid rgba(255, 255, 255, 0.3);
    }
    .info-box strong {
        color: #fff;
    }
</style>

<div class=""widget-container"">
    <div class=""task-section"">
        <h2>&#128293; High Priority</h2>
        <div class=""task-item high"">
            <div class=""task-checkbox"">&#9744;</div>
            <div class=""task-content"">
                <div class=""task-title"">Complete project presentation</div>
                <div class=""task-meta"">Due: Today at 5:00 PM</div>
            </div>
        </div>
        <div class=""task-item high"">
            <div class=""task-checkbox"">&#9744;</div>
            <div class=""task-content"">
                <div class=""task-title"">Client meeting preparation</div>
                <div class=""task-meta"">Due: Tomorrow</div>
            </div>
        </div>
    </div>

    <div class=""task-section"">
        <h2>&#9889; Normal Priority</h2>
        <div class=""task-item normal"">
            <div class=""task-checkbox"">&#9744;</div>
            <div class=""task-content"">
                <div class=""task-title"">Review code changes</div>
                <div class=""task-meta"">Team review pending</div>
            </div>
        </div>
        <div class=""task-item normal"">
            <div class=""task-checkbox"">&#9744;</div>
            <div class=""task-content"">
                <div class=""task-title"">Update documentation</div>
                <div class=""task-meta"">Due: This week</div>
            </div>
        </div>
        <div class=""task-item normal"">
            <div class=""task-checkbox"">&#9744;</div>
            <div class=""task-content"">
                <div class=""task-title"">Email responses</div>
                <div class=""task-meta"">5 pending</div>
            </div>
        </div>
    </div>

    <div class=""task-section"">
        <h2>&#128204; Low Priority</h2>
        <div class=""task-item low"">
            <div class=""task-checkbox"">&#9744;</div>
            <div class=""task-content"">
                <div class=""task-title"">Organize files</div>
                <div class=""task-meta"">When free</div>
            </div>
        </div>
    </div>

    <div class=""info-box"">
        &#128161; <strong>Tip:</strong> Click the tray icon to unlock and edit this widget!
    </div>
</div>";

            File.WriteAllText(_htmlFilePath, defaultHtml);
        }

        private void LoadSettings()
        {
            try
            {
                if (File.Exists(_settingsPath))
                {
                    string[] lines = File.ReadAllLines(_settingsPath);
                    if (lines.Length >= 5)
                    {
                        Left = double.Parse(lines[0]);
                        Top = double.Parse(lines[1]);
                        Width = double.Parse(lines[2]);
                        Height = double.Parse(lines[3]);
                        _isLocked = bool.Parse(lines[4]);
                    }
                }
            }
            catch { }
        }

        private void SaveSettings()
        {
            try
            {
                string[] settings = {
                    Left.ToString(),
                    Top.ToString(),
                    Width.ToString(),
                    Height.ToString(),
                    _isLocked.ToString()
                };
                File.WriteAllLines(_settingsPath, settings);
            }
            catch { }
        }

        private void MakeWebBrowserTransparent()
        {
            try
            {
                // Get the WebBrowser control's window handle
                var browserHandle = ((HwndSource)PresentationSource.FromVisual(HtmlBrowser))?.Handle;
                if (browserHandle == IntPtr.Zero || browserHandle == null)
                    return;

                // Apply transparent style to the WebBrowser and all its child windows
                EnumChildWindows(browserHandle.Value, (hwnd, lParam) =>
                {
                    try
                    {
                        int extendedStyle = GetWindowLong(hwnd, GWL_EXSTYLE);
                        SetWindowLong(hwnd, GWL_EXSTYLE, extendedStyle | WS_EX_TRANSPARENT);
                    }
                    catch { }
                    return true; // Continue enumeration
                }, IntPtr.Zero);

                // Also apply to the browser's own handle
                int browserStyle = GetWindowLong(browserHandle.Value, GWL_EXSTYLE);
                SetWindowLong(browserHandle.Value, GWL_EXSTYLE, browserStyle | WS_EX_TRANSPARENT);
            }
            catch { }
        }
    }
}
