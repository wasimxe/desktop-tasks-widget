<Window x:Class="DesktopTasks.Windows.TaskManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task Manager" Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- Task List Panel -->
        <Border Grid.Column="0" Background="White" Margin="10" CornerRadius="5" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="All Tasks" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

                <ListView Grid.Row="1" x:Name="TasksListView" SelectionChanged="TasksListView_SelectionChanged">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Status" Width="60">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsCompleted}"
                                                 Checked="TaskCompleted_Checked"
                                                 Unchecked="TaskCompleted_Checked"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Title" Width="200" DisplayMemberBinding="{Binding Title}"/>
                            <GridViewColumn Header="Priority" Width="80" DisplayMemberBinding="{Binding Priority}"/>
                            <GridViewColumn Header="Due Date" Width="100" DisplayMemberBinding="{Binding DueDate, StringFormat='{}{0:yyyy-MM-dd}'}"/>
                        </GridView>
                    </ListView.View>
                </ListView>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="New Task" Click="NewTask_Click" Padding="15,8" Margin="0,0,10,0"/>
                    <Button Content="Delete Selected" Click="DeleteTask_Click" Padding="15,8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Task Editor Panel -->
        <Border Grid.Column="1" Background="White" Margin="10" CornerRadius="5" Padding="15">
            <Grid x:Name="EditorPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Task Details" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

                <TextBlock Grid.Row="1" Text="Title:" Margin="0,0,0,5"/>
                <TextBox Grid.Row="2" x:Name="TitleTextBox" Margin="0,0,0,15"/>

                <TextBlock Grid.Row="3" Text="Description:" Margin="0,0,0,5"/>
                <TextBox Grid.Row="4" x:Name="DescriptionTextBox" TextWrapping="Wrap"
                        Height="100" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15"/>

                <Grid Grid.Row="5" Margin="0,0,0,15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Priority:" Margin="0,0,5,5"/>
                    <ComboBox Grid.Row="1" Grid.Column="0" x:Name="PriorityComboBox" Margin="0,0,5,10"/>

                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Due Date:" Margin="5,0,0,5"/>
                    <DatePicker Grid.Row="1" Grid.Column="1" x:Name="DueDatePicker" Margin="5,0,0,10"/>
                </Grid>

                <StackPanel Grid.Row="7" Orientation="Vertical" VerticalAlignment="Bottom">
                    <Button Content="Save Task" Click="SaveTask_Click" Padding="15,10" Margin="0,0,0,10"/>
                    <Button Content="Clear" Click="ClearForm_Click" Padding="15,10"/>
                </StackPanel>

                <TextBlock Grid.Row="0" Grid.RowSpan="8" x:Name="NoSelectionMessage"
                          Text="Select a task or click 'New Task' to get started"
                          FontSize="14" Foreground="#999" TextAlignment="Center"
                          TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
